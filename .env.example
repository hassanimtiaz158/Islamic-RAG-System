# ── Islamic RAG System ──
# Copy this file to .env and fill in your values

# LLM Provider: "ollama" (local), "openai", or "groq" (free tier)
LLM_PROVIDER=ollama

# Ollama configuration (used when LLM_PROVIDER=ollama)
LLM_MODEL=phi3
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI configuration (used when LLM_PROVIDER=openai)
# Get your API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq configuration (used when LLM_PROVIDER=groq)
# Get your free API key at https://console.groq.com
GROQ_API_KEY=
# Recommended free models: llama-3.1-8b-instant, llama-3.3-70b-versatile

# LangSmith tracing (optional)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000
