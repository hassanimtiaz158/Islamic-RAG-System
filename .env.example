# ═══════════════════════════════════════════════
# Al-Ilm Islamic RAG System — Environment Configuration
# SaaS Edition
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values

# ── Application ──
APP_NAME=Al-Ilm
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=development  # development, staging, production

# ── Server ──
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# ── Database (MongoDB) ──
# For local development: mongodb://localhost:27017
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=islamic_rag

# ── Redis ──
# For local development: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Authentication ──
# IMPORTANT: Change this in production! Use: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM Provider ──
# Supported: ollama, openai, groq, anthropic
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant

# Provider API keys
GROQ_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Vector Store ──
VECTOR_STORE_PATH=data/vectorstore

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_RPM=60

# ── Billing (Phase 3) ──
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── External APIs ──
# HadithAPI.com key (used by scripts/load_hadiths.py)
# Get a free key at https://hadithapi.com
HADITH_API_KEY=
